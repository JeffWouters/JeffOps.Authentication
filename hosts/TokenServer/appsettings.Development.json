{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "authentication": "Server=(localdb)\\MSSQLLocalDB;Database=JeffOpsAuthentication;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JeffOps": {
    "TokenServer": {
      "Issuer": "https://localhost:5001/",
      "Clients": [
        {
          "ClientId": "bff",
          "ClientSecret": "development-only-secret-replace-in-user-secrets",
          "Kind": "Confidential",
          "GrantTypes": [ "authorization_code", "refresh_token" ],
          "RedirectUris": [ "https://localhost:5003/bff/callback" ],
          "PostLogoutRedirectUris": [ "https://localhost:5003/" ],
          "Scopes": [ "openid", "profile", "email", "offline_access", "api", "account" ]
        }
      ]
    },
    "ForwardedHeaders": {
      "NoTrustedProxy": true
    }
  }
}
