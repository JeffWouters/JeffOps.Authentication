{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "authentication": ""
  },
  "JeffOps": {
    "TokenServer": {
      "Issuer": "https://localhost:5001/",
      "ApiScopes": {
        "api": [ "api" ]
      },
      "Clients": [
        {
          "ClientId": "bff",
          "ClientSecret": "",
          "Kind": "Confidential",
          "GrantTypes": [ "authorization_code", "refresh_token" ],
          "RedirectUris": [ "https://localhost:5003/bff/callback" ],
          "PostLogoutRedirectUris": [ "https://localhost:5003/" ],
          "Scopes": [ "openid", "profile", "email", "offline_access", "api" ]
        }
      ]
    },
    "ForwardedHeaders": {
      "NoTrustedProxy": true
    }
  }
}
