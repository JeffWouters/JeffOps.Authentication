<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only, and every package is mapped to it: a same-named package on another feed (a
     dependency-confusion attack) is never used. docs/DESIGN.md §6.5. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
