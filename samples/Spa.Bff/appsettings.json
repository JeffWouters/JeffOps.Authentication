{
  "JeffOps": {
    "Bff": {
      "Authority": "https://localhost:5001/",
      "ClientId": "bff",
      "ClientSecret": "",
      "Scopes": [ "profile", "email", "api" ]
    },
    "PatExchange": {
      "TokenEndpoint": "https://localhost:5001/connect/token",
      "ClientId": "gateway",
      "ClientSecret": ""
    },
    "SecurityHeaders": {
      "ContentSecurityPolicy": "default-src 'self'; frame-ancestors 'none'"
    },
    "ForwardedHeaders": {
      "NoTrustedProxy": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": { "ClusterId": "api", "Match": { "Path": "/api/{**rest}" } }
    },
    "Clusters": {
      "api": { "Destinations": { "api": { "Address": "https://localhost:5005/" } } }
    }
  }
}
