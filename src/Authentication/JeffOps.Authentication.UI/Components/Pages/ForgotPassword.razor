@page "/account/forgot-password"
@inject IEnumerable<InteractiveSignInMethod> SignInMethods

<PageTitle>Reset your password</PageTitle>

<main class="jo-login">
    <h1>Reset your password</h1>

    @if (!PasswordsEnabled)
    {
        <p class="jo-error" role="alert">Passwords aren't used here. Go back and sign in another way.</p>
    }
    else if (Sent)
    {
        <p class="jo-notice" role="status">If an account uses that address, we've sent it a link to set a new password. The link works for a short while.</p>
        <p><a href="/account/login">Back to sign in</a></p>
    }
    else
    {
        <form method="post" action="/account/local/password/forgot/form" class="jo-password">
            <AntiforgeryToken />
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" required autofocus />
            <button type="submit">Send a reset link</button>
        </form>
    }
</main>
