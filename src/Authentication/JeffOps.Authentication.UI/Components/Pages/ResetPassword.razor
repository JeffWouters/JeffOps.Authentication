@page "/account/reset-password"
@inject IEnumerable<InteractiveSignInMethod> SignInMethods

<PageTitle>Set a new password</PageTitle>

<main class="jo-login">
    <h1>Set a new password</h1>

    @if (Done)
    {
        <p class="jo-notice" role="status">Your password is changed, and you are signed out everywhere else.</p>
        <p><a href="/account/login">Sign in</a></p>
    }
    else if (!PasswordsEnabled || string.IsNullOrEmpty(Token))
    {
        <p class="jo-error" role="alert">This link is incomplete. Ask for a new one.</p>
        <p><a href="/account/forgot-password">Reset your password</a></p>
    }
    else
    {
        @if (ErrorMessage is not null)
        {
            <p class="jo-error" role="alert">@ErrorMessage</p>
        }

        <form method="post" action="/account/local/password/reset/form" class="jo-password">
            <AntiforgeryToken />
            <input type="hidden" name="token" value="@Token" />
            <label for="password">New password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required autofocus />
            <button type="submit">Set password</button>
        </form>
    }
</main>
